{
  "buildCommand": "npx prisma generate && next build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "hustlealliance.com"
        }
      ],
      "destination": "https://www.hustlealliance.com/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/release-drip",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/class-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/feed-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/automations",
      "schedule": "*/15 * * * *"
    }
  ]
}
