{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "hustlealliance.com"
        }
      ],
      "destination": "https://www.hustlealliance.com/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/release-drip",
      "schedule": "*/5 * * * *"
    }
  ]
}
