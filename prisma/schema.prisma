generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  ARTICLE
  QUIZ
  ASSIGNMENT
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum BadgeCategory {
  LEARNING
  STREAK
  SOCIAL
  MILESTONE
}

enum MembershipTier {
  FREE
  BASIC
  PRO
}

enum ContentAccessLevel {
  FREE
  BASIC
  PRO
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  COURSE_ENROLLED
  LESSON_COMPLETED
  BADGE_EARNED
  CERTIFICATE_ISSUED
  COURSE_EXPIRING
  LIVE_CLASS_REMINDER
  QUIZ_PASSED
  XP_MILESTONE
  CONTENT_UNLOCKED
  // ── Community social types ──
  FOLLOWED
  POST_LIKED
  COMMENT_LIKED
  COMMENTED
  MENTIONED
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  GROUP_INVITE
  GROUP_JOIN_REQUEST
  GROUP_POST
  EVENT_INVITE
  EVENT_REMINDER
  NEW_MESSAGE
  JOB_APPLICATION_UPDATE
}

enum DripScheduleType {
  CALENDAR
  INTERVAL_DAYS
  INTERVAL_LESSONS
}

// ── Community Enums ──────────────────────────────────────────────────────

enum PostVisibility {
  PUBLIC
  CONNECTIONS_ONLY
  GROUP_ONLY
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum MentionEntityType {
  POST
  COMMENT
  MESSAGE
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
  HIDDEN
}

enum CommunityGroupRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum CommunityGroupMemberStatus {
  ACTIVE
  INVITED
  REQUESTED
  BANNED
}

enum EventType {
  ONLINE
  IN_PERSON
  HYBRID
}

enum EventStatus {
  UPCOMING
  LIVE
  ENDED
  CANCELLED
}

enum RSVPStatus {
  GOING
  INTERESTED
  NOT_GOING
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  CO_FOUNDER
}

enum JobStatus {
  OPEN
  CLOSED
  FILLED
  DRAFT
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
}

enum ProductType {
  DIGITAL
  PHYSICAL
  COURSE
  MEMBERSHIP
}

enum StoreOrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum FeedItemType {
  POST_CREATED
  POST_LIKED
  COMMENT_CREATED
  USER_FOLLOWED
  FRIEND_ACCEPTED
  GROUP_JOINED
  EVENT_CREATED
  EVENT_RSVP
  BADGE_EARNED
  JOB_POSTED
  PRODUCT_LISTED
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  name                String
  avatar              String?
  username            String?        @unique
  role                UserRole       @default(STUDENT)
  membershipTier      MembershipTier @default(FREE)
  membershipExpiresAt DateTime?
  stripeCustomerId    String?        @unique
  bio                 String?
  headline            String?
  coverPhoto          String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // ── Existing LMS relations ──
  enrollments       Enrollment[]
  lessonProgress    LessonProgress[]
  quizAttempts      QuizAttempt[]
  certificates      Certificate[]
  earnedBadges      EarnedBadge[]
  instructorCourses Course[]          @relation("CourseInstructor")
  posts                CommunityPost[]
  comments             CommunityComment[]
  studyGroupMemberships CourseGroupMember[]
  studyGroupPosts       CourseGroupPost[]
  studyGroupReplies     CourseGroupReply[]
  studyGroupFiles       CourseGroupFile[]
  xpTransactions    XPTransaction[]
  streak            Streak?
  liveClassRegs     LiveClassRegistration[]
  taughtLiveClasses LiveClass[]        @relation("LiveClassInstructor")
  orders            Order[]
  notifications     Notification[]
  entitlements      Entitlement[]
  contentReleases   ContentRelease[]

  // ── NEW: Extended profile ──
  profile            Profile?
  memberLists        MemberList[]      // Lists they've created
  savedInLists       MemberListItem[]  // Lists they've been added to

  // ── NEW: Social graph ──
  followers          Follow[]              @relation("UserFollowed")
  following          Follow[]              @relation("UserFollower")
  friendships        Friendship[]          @relation("UserA")
  friendOf           Friendship[]          @relation("UserB")

  // ── NEW: Post/comment likes ──
  postLikes          PostLike[]
  commentLikes       CommentLike[]

  // ── NEW: Messages ──
  sentMessages       Message[]              @relation("MessageSender")
  messageReads       MessageRead[]
  conversations      ConversationParticipant[]

  // ── NEW: Community groups ──
  communityGroupMemberships CommunityGroupMember[]
  communityGroupPosts       CommunityGroupPost[]
  communityGroupComments    CommunityGroupComment[]

  // ── NEW: Events ──
  eventRSVPs         EventRSVP[]
  eventDiscussions   EventDiscussion[]
  createdEvents      Event[]               @relation("EventCreator")

  // ── NEW: Jobs ──
  jobListings        JobListing[]
  jobApplications    JobApplication[]

  // ── NEW: Store ──
  storeOrders        StoreOrder[]
  storeReviews       StoreReview[]

  // ── NEW: Mentions ──
  mentionsReceived   Mention[]

  // ── NEW: Post shares & reports ──
  shares             CommunityShare[]
  reports            CommunityReport[]

  // ── NEW: Activity feed ──
  feedItemsOwned FeedItem[] @relation("FeedOwner")
  feedItemsActed FeedItem[] @relation("FeedActor")

  // ── NEW: Search ──
  searchQueries      SearchQuery[]

  // ── NEW: Blocks ──
  blockedUsers       BlockedUser[]          @relation("BlockedBy")
  blockedByUsers     BlockedUser[]          @relation("BlockedUser")

  // ── NEW: Groups created ──
  createdGroups      CommunityGroup[]

  // ── NEW: Notification preferences ──
  notificationPreference NotificationPreference?
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  courses     Course[]
}

model Course {
  id              String            @id @default(uuid())
  title           String
  slug            String            @unique
  tagline         String
  description     String
  thumbnail       String?
  difficulty      Difficulty        @default(BEGINNER)
  accessLevel     ContentAccessLevel @default(FREE)
  durationWeeks   Int?
  totalMinutes    Int?
  studentCount    Int               @default(0)
  price           Float?
  status          CourseStatus      @default(DRAFT)
  categoryId      String
  instructorId    String
  communitySpaceSlug String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  category      Category          @relation(fields: [categoryId], references: [id])
  instructor    User              @relation("CourseInstructor", fields: [instructorId], references: [id])
  modules       Module[]
  enrollments   Enrollment[]
  certificates  Certificate[]
  orders        Order[]
  attachments   CourseAttachment[]
  liveClasses   LiveClass[]
  entitlements  Entitlement[]
  dripSettings  CourseDripSettings?
  studyGroup    CourseStudyGroup?
}

model Module {
  id        String @id @default(uuid())
  courseId  String
  title     String
  sortOrder Int

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Lesson {
  id              String             @id @default(uuid())
  moduleId        String
  title           String
  slug            String
  content         String?
  videoUrl        String?
  durationMinutes Int?
  sortOrder       Int
  isPreview       Boolean            @default(false)
  lessonType      LessonType         @default(VIDEO)
  accessLevel     ContentAccessLevel?

  module      Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  quiz        Quiz?
  attachments LessonAttachment[]
  entitlements Entitlement[]
  orders      Order[]
  dripOverride LessonDripOverride?
  releases    ContentRelease[]
  prerequisites LessonPrerequisite[]       @relation("LessonPrereqs")
  requiredBy    LessonPrerequisite[]       @relation("LessonPrerequisiteFor")
}

model CourseAttachment {
  id        String   @id @default(uuid())
  courseId  String
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int?
  uploadedAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model LessonAttachment {
  id        String   @id @default(uuid())
  lessonId  String
  fileName  String
  fileUrl   String
  fileType  String
  uploadedAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id          String    @id @default(uuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  expiresAt   DateTime?
  progressPct Float     @default(0)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id                   String   @id @default(uuid())
  userId               String
  lessonId             String
  completed            Boolean  @default(false)
  completedAt          DateTime?
  videoPositionSeconds Int      @default(0)
  lastAccessedAt       DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Quiz {
  id              String  @id @default(uuid())
  title           String?
  lessonId        String  @unique
  passingScore    Int     @default(70)
  timeLimitMinutes Int?
  randomizeOrder  Boolean @default(false)
  maxAttempts     Int?

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id           String       @id @default(uuid())
  quizId       String
  questionText String
  questionType QuestionType @default(MULTIPLE_CHOICE)
  sortOrder    Int
  explanation  String?

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]
}

model QuizAnswer {
  id         String  @id @default(uuid())
  questionId String
  answerText String
  isCorrect  Boolean @default(false)
  sortOrder  Int

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String    @id @default(uuid())
  userId      String
  quizId      String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Float?
  passed      Boolean?
  answers     Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String       @id @default(uuid())
  name        String       @unique
  description String
  icon        String
  category    BadgeCategory
  requirement Int

  earnedBy EarnedBadge[]
}

model EarnedBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model XPTransaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Streak {
  id             String   @id @default(uuid())
  userId         String   @unique
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Certificate {
  id             String   @id @default(uuid())
  userId         String
  courseId       String
  issuedAt       DateTime @default(now())
  certificateUrl String?
  uniqueCode     String   @unique @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LiveClass {
  id           String   @id @default(uuid())
  title        String
  description  String?
  instructorId String
  courseId     String?
  platform     String   @default("JITSI")
  meetingUrl   String?
  roomName     String?
  startsAt     DateTime
  endsAt       DateTime
  maxAttendees Int?
  createdAt    DateTime @default(now())

  instructor    User                     @relation("LiveClassInstructor", fields: [instructorId], references: [id])
  course        Course?                  @relation(fields: [courseId], references: [id])
  registrations LiveClassRegistration[]
}

model LiveClassRegistration {
  id           String   @id @default(uuid())
  userId       String
  liveClassId  String
  registeredAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveClass LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  @@unique([userId, liveClassId])
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  courseId        String?
  lessonId        String?
  amount          Float
  currency        String      @default("USD")
  status          OrderStatus @default(PENDING)
  stripeSessionId String?     @unique
  createdAt       DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson  Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  entitlement Entitlement?
}

model Entitlement {
  id          String   @id @default(uuid())
  userId      String
  courseId    String?
  lessonId    String?
  purchasedAt DateTime @default(now())
  price       Float?
  orderId     String?  @unique

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@unique([userId, lessonId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  sourceId  String?          // Entity that triggered this notification (post, comment, user, group, event, message, job)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([type])
}

model NotificationPreference {
  userId      String @id
  preferences Json   @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CourseDripSettings {
  id           String           @id @default(uuid())
  courseId     String           @unique
  enabled      Boolean          @default(false)
  type         DripScheduleType @default(INTERVAL_DAYS)
  intervalDays Int              @default(3)
  startDate    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model LessonDripOverride {
  id             String           @id @default(uuid())
  lessonId       String           @unique
  type           DripScheduleType @default(INTERVAL_DAYS)
  intervalDays   Int?
  unlockAt       DateTime?
  minLessonsDone Int?
  createdAt      DateTime         @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model ContentRelease {
  id         String   @id @default(uuid())
  userId     String
  lessonId   String
  releasesAt DateTime
  isReleased Boolean  @default(false)
  createdAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model LessonPrerequisite {
  id                    String @id @default(uuid())
  lessonId              String
  prerequisiteLessonId  String

  lesson            Lesson @relation("LessonPrereqs", fields: [lessonId], references: [id], onDelete: Cascade)
  prerequisite      Lesson @relation("LessonPrerequisiteFor", fields: [prerequisiteLessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, prerequisiteLessonId])
}

model CommunityPost {
  id         String         @id @default(uuid())
  authorId   String
  content    String
  space      String?
  imageUrls  String[]       @default([])
  isPinned   Boolean        @default(false)
  isEdited   Boolean        @default(false)
  editedAt   DateTime?
  isDeleted  Boolean        @default(false)
  deletedAt  DateTime?
  locale     String         @default("en")
  excerpt    String?
  visibility PostVisibility @default(PUBLIC)
  groupId    String?
  group      CommunityGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())

  author   User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments CommunityComment[]
  likes    PostLike[]
  shares   CommunityShare[]
  reports  CommunityReport[]

  @@index([authorId, createdAt])
  @@index([groupId, createdAt])
  @@index([space, createdAt])
  @@index([createdAt])
  @@index([isDeleted])
}

model CommunityComment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post    CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes   CommentLike[]

  @@index([postId, createdAt])
  @@index([authorId])
}

// ── Course Study Groups (ISOLATED — zero FK overlap with CommunityPost/Comment/Spaces) ──

model CourseStudyGroup {
  id          String   @id @default(uuid())
  courseId    String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members CourseGroupMember[]
  posts   CourseGroupPost[]
  files   CourseGroupFile[]
}

model CourseGroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group CourseStudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model CourseGroupPost {
  id        String   @id @default(uuid())
  groupId   String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group   CourseStudyGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author  User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies CourseGroupReply[]
}

model CourseGroupReply {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   CourseGroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model CourseGroupFile {
  id         String   @id @default(uuid())
  groupId    String
  uploaderId String
  fileName   String
  fileUrl    String
  fileSize   Int
  mimeType   String
  createdAt  DateTime @default(now())

  group    CourseStudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  uploader User             @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════════════════
// ── COMMUNITY MODULE: Profiles, Social Graph, Groups, Events, Jobs, Store
// ═══════════════════════════════════════════════════════════════════════

// ── Extended Profile ───────────────────────────────────────────────────

model Profile {
  id              String   @id @default(uuid())
  userId          String   @unique
  displayName     String?
  location        String?
  website         String?
  socialLinks     Json?    // { twitter, linkedin, github, instagram, youtube }
  skills          String[] @default([])
  industries      String[] @default([])
  yearsExperience Int?
  headline        String?
  summary         String?
  phone           String?
  dateOfBirth     DateTime?
  privacySettings Json?    // { showEmail, showLocation, showActivity }
  interests       String[] @default([])  // e.g. ["AI/ML", "Fundraising", "Remote Work"]
  canHelpWith     String[] @default([])  // e.g. ["Pitch Decks", "Hiring Engineers", "SEO"]
  lookingFor      String[] @default([])  // e.g. ["Co-founder", "Angel Investors", "Beta Users"]
  businessInfo    String?                // Description of their business/startup
  hasOpportunities Boolean  @default(false)  // Whether they have job/business opportunities listed
  marketplaceSeller Boolean @default(false) // Whether they have marketplace listings
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Follow (asymmetric social graph) ────────────────────────────────────

model Follow {
  id          String   @id @default(uuid())
  followerId  String   // User who follows
  followedId  String   // User being followed
  createdAt   DateTime @default(now())

  follower User @relation("UserFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("UserFollowed", fields: [followedId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])
  @@index([followedId])
  @@index([followerId])
}

// ── Friendship (symmetric, request-based) ──────────────────────────────

model Friendship {
  id             String           @id @default(uuid())
  userAId        String           // Sender
  userBId        String           // Receiver
  status         FriendshipStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  userA User @relation("UserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("UserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId, status])
  @@index([userAId, status])
}

// ── Blocking ────────────────────────────────────────────────────────────

model BlockedUser {
  id           String   @id @default(uuid())
  blockedById  String   // User who blocks
  blockedUserId String  // User being blocked
  createdAt    DateTime @default(now())

  blockedBy  User @relation("BlockedBy", fields: [blockedById], references: [id], onDelete: Cascade)
  blockedUser User @relation("BlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockedById, blockedUserId])
}

// ── Post Likes ─────────────────────────────────────────────────────────

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

// ── Post Shares ────────────────────────────────────────────────────────

model CommunityShare {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String?  // Optional reshare comment
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId])
}

// ── Post Reports ───────────────────────────────────────────────────────

model CommunityReport {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  reason    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

// ── Comment Likes ──────────────────────────────────────────────────────

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

// ── Mentions ────────────────────────────────────────────────────────────

model Mention {
  id          String           @id @default(uuid())
  entityType  MentionEntityType
  entityId    String           // ID of post, comment, or message
  userId      String           // User who was mentioned
  mentionedBy String           // ID of user who made the mention
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

// ── Conversations (DMs) ────────────────────────────────────────────────

model Conversation {
  id         String   @id @default(uuid())
  name       String?  // Optional group chat name
  isGroup    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime  @default(now())
  lastTypedAt    DateTime?
  isArchived     Boolean   @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String
  type           MessageType @default(TEXT)
  content        String
  attachmentUrl  String?
  createdAt      DateTime    @default(now())
  editedAt       DateTime?

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reads        MessageRead[]

  @@index([conversationId, createdAt])
}

model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

// ── Community Groups ────────────────────────────────────────────────────

model CommunityGroup {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  avatar      String?
  coverImage  String?
  visibility  GroupVisibility @default(PUBLIC)
  creatorId   String
  memberCount Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  creator  User                    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members  CommunityGroupMember[]
  groupPosts CommunityGroupPost[]
  posts    CommunityPost[]
  events   Event[]

  @@index([slug])
  @@index([visibility, memberCount])
}

model CommunityGroupMember {
  id        String                     @id @default(uuid())
  groupId   String
  userId    String
  role      CommunityGroupRole         @default(MEMBER)
  status    CommunityGroupMemberStatus @default(ACTIVE)
  joinedAt  DateTime                   @default(now())

  group CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

// ── Community Group Posts & Comments ───────────────────────────────────

model CommunityGroupPost {
  id        String   @id @default(uuid())
  groupId   String
  authorId  String
  content   String
  imageUrls String[] @default([])
  isPinned  Boolean  @default(false)
  isEdited  Boolean  @default(false)
  editedAt  DateTime?
  createdAt DateTime @default(now())

  group    CommunityGroup            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author   User                      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments CommunityGroupComment[]

  @@index([groupId, createdAt])
  @@index([authorId])
}

model CommunityGroupComment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   CommunityGroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User               @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// ── Events ──────────────────────────────────────────────────────────────

model Event {
  id          String      @id @default(uuid())
  title       String
  slug        String      @unique
  description String?
  type        EventType   @default(ONLINE)
  status      EventStatus @default(UPCOMING)
  location    String?     // URL for online, address for in-person
  startDate   DateTime
  endDate     DateTime?
  coverImage  String?
  maxAttendees Int?
  isFeatured  Boolean     @default(false)
  creatorId   String
  groupId     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  creator User        @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  group   CommunityGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  rsvps        EventRSVP[]
  discussions  EventDiscussion[]

  @@index([startDate])
  @@index([groupId, startDate])
  @@index([status, startDate])
  @@index([slug])
}

model EventRSVP {
  id        String      @id @default(uuid())
  eventId   String
  userId    String
  status    RSVPStatus  @default(GOING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId, status])
}

// ── Event Discussions ──────────────────────────────────────────────────

model EventDiscussion {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([userId])
}

// ── Job Board ───────────────────────────────────────────────────────────

model JobListing {
  id            String          @id @default(uuid())
  title         String
  company       String
  slug          String          @unique
  description   String
  type          JobType         @default(FULL_TIME)
  status        JobStatus       @default(OPEN)
  location      String?
  isRemote      Boolean         @default(false)
  salaryRange   String?
  requirements  String[]        @default([])
  applicationUrl String?
  contactEmail  String?
  postedById    String
  applicantCount Int            @default(0)
  expiresAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  postedBy     User             @relation(fields: [postedById], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([status, createdAt])
  @@index([postedById])
  @@index([slug])
}

model JobApplication {
  id          String            @id @default(uuid())
  jobId       String
  applicantId String
  status      ApplicationStatus @default(SUBMITTED)
  coverLetter String?
  resumeUrl   String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job       JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant User       @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([jobId, applicantId])
  @@index([applicantId])
  @@index([status])
}

// ── Online Store ────────────────────────────────────────────────────────

model Product {
  id          String      @id @default(uuid())
  title       String
  slug        String      @unique
  description String
  type        ProductType @default(DIGITAL)
  price       Float
  compareAt   Float?      // Original price for sale display
  currency    String      @default("USD")
  images      String[]    @default([])
  stock       Int         @default(0)
  isPublished Boolean     @default(false)
  metadata    Json?       // Course ID for course products, file URL for digital
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orders  StoreOrderItem[]
  reviews StoreReview[]

  @@index([type, isPublished])
  @@index([slug])
}

model StoreOrder {
  id        String          @id @default(uuid())
  userId    String
  status    StoreOrderStatus @default(PENDING)
  totalAmount Float
  currency  String          @default("USD")
  stripePaymentIntentId String?
  paidAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items StoreOrderItem[]

  @@index([userId, createdAt])
  @@index([stripePaymentIntentId])
}

model StoreOrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  quantity  Int    @default(1)
  unitPrice Float
  totalPrice Float

  order   StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
}

model StoreReview {
  id        String   @id @default(uuid())
  productId String
  userId    String
  rating    Int      // 1-5
  body      String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
}

// ── Activity Feed (fanout-on-write) ────────────────────────────────────

model FeedItem {
  id         String       @id @default(uuid())
  ownerId    String       // The user whose feed this belongs to
  actorId    String       // The user who performed the action
  type       FeedItemType
  entityType String       // "Post", "Comment", "Event", "Group", "Friendship", "Job", "Product"
  entityId   String       // ID of the entity
  metadata   Json?        // Optional: preview text, counts, etc.
  createdAt  DateTime     @default(now())

  owner User @relation("FeedOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  actor User @relation("FeedActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([actorId])
}

// ── Search ──────────────────────────────────────────────────────────────

model SearchQuery {
  id        String   @id @default(uuid())
  userId    String
  term      String
  results   Int      @default(0) // Number of results returned
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Member Lists (user-curated contact lists) ──────────────────────────

model MemberList {
  id          String   @id @default(uuid())
  ownerId     String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items MemberListItem[]

  @@index([ownerId])
}

model MemberListItem {
  id        String   @id @default(uuid())
  listId    String
  memberId  String
  note      String?  // Optional note about why they were added
  addedAt   DateTime @default(now())

  list   MemberList @relation(fields: [listId], references: [id], onDelete: Cascade)
  member User       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([listId, memberId])
  @@index([memberId])
}
