{
  "name": "hustlealliance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bash scripts/migrate-deploy.sh && next build",
    "build:full": "npx prisma generate && next build",
    "db:migrate": "npx prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts && npx tsx prisma/seed-community.ts && npx tsx prisma/seed-blog-posts.ts && npx tsx prisma/seed-expand-all.ts && npx tsx prisma/seed-nas-io.ts && npx tsx prisma/seed-challenges.ts",
    "db:setup": "npx prisma generate && npx prisma migrate deploy && npx tsx prisma/seed.ts && npx tsx prisma/seed-community.ts",
    "postinstall": "npx prisma generate",
    "start": "next start",
    "lint": "eslint",
    "analyze": "ANALYZE=true next build --webpack"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.67",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/edge-config": "^1.5.0",
    "ai": "^7.0.83",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.0",
    "stripe": "^22.3.2",
    "web-push": "^3.6.7",
    "zustand": "^5.0.14"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "svgo": "^4.0.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true
  }
}
