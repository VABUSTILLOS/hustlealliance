# ─── Supabase (required) ──────────────────────────────────────────
# 1. Go to https://supabase.com and create a new project
# 2. Go to Project Settings > API
# 3. Copy your project URL and anon/public key below
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Database (Prisma local dev) ─────────────────────────────────
DATABASE_URL=postgresql://prisma@localhost:5432/mydb?sslmode=disable

# ─── Stripe (optional — payments) ─────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_BASIC_MONTHLY=price_basic_monthly
# STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly

# ─── Resend (optional — transactional emails) ─────────────────────
# RESEND_API_KEY=re_...
# EMAIL_FROM=hustlealliance@resend.dev

# ─── Prisma AI Safety (required for db push) ──────────────────────
PRISMA_USER_CONSENT_FOR_DANGEROUS_AI_ACTION=true

# ─── OmniRoute (local AI gateway, optional) ─────────────────────
# Local AI router: point any OpenAI-compatible SDK at OMNIROUTE_BASE_URL
# with OMNIROUTE_API_KEY. Requires the omniroute server running locally.
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_API_KEY=sk-your-omniroute-key

# Web Push (PWA) — generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ─── Vercel AI Gateway (optional — real AI output) ────────────────
# Create a key at https://vercel.com → your team → AI Gateway → API keys.
# Without it, all AI features serve deterministic demo output.
# AI_GATEWAY_API_KEY=your-gateway-key
# Model used by AI Studio + member AI (provider/model slug, dots not hyphens):
# AI_DEFAULT_MODEL=openai/gpt-5.4-mini
# Force demo output even when the key is set (also toggleable live in
# Admin → Settings → AI Demo Mode):
# AI_FORCE_DEMO=false
